<!DOCTYPE html>
<html lang="ko">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>폴리오 - 일기</title>
        <link rel="stylesheet" href="/css/manage.css">
        <link rel="stylesheet" href="/css/calendar.css">
        <link rel="stylesheet" href="/css/sidebar.css">
        <link rel="stylesheet" href="/css/diary.css">
        <link rel="stylesheet" href="/css/diary-extra.css?v=4">
    </head>
    <body>
        <div class="appShell">
            {{! 컨트롤러에서 pageTitle="일기", navDairy=true 를 내려주세요 }}
            {{> layout/sidebar}}
            <main class="mainArea">
                <div class="topBar"></div>
                <section class="notebook">
                    {{! 컨트롤러에서 bookmarks = BookmarkLayout.of(1) 을 내려주세요 (일기 = 왼쪽 1개, 오른쪽 3개) }}
                    {{> layout/bookLayout}}

                    <!-- 왼쪽: 연도별 기록 요약 -->
                    <section class="leftPage diaryLeftPage">
                        <h1>일기 :</h1>
                        <p class="diaryIntro">매일 나의 기분과 하루를 기록해보세요.</p>

                        <!-- 연도 화면: 연도 이동 + 기분 그래프 + 월별 폴더 -->
                        <div id="yearView">
                            <div class="yearNav">
                                <button type="button" id="prevYearBtn" aria-label="이전 연도">‹</button>
                                <span class="yearLabel" id="diaryYearLabel">2026</span>
                                <span>년도의 기록</span>
                                <button type="button" id="nextYearBtn" aria-label="다음 연도">›</button>
                            </div>

                            <!-- 기분 그래프: 일기를 쓴 날마다 스틱 하나 (10일이 넘으면 옆으로 슬라이드) -->
                            <div class="moodBox isEmpty" id="moodBox">
                                <div class="moodScroll" id="moodScroll">
                                    <div class="moodTrack" id="moodTrack">
                                        <div class="moodChart" id="moodChart" role="img" aria-label="일별 기분 그래프"></div>
                                        <div class="moodLabels" id="moodLabels"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- 일기를 쓴 달만 폴더로 보임 (많아지면 스크롤) -->
                            <div class="folderGrid" id="folderGrid"></div>
                            <p class="diaryEmptyYear muted" id="emptyYear" hidden></p>
                        </div>

                        <!-- 폴더 클릭 시: 그 달의 기록지 -->
                        <div class="monthView" id="monthView" hidden>
                            <div class="monthSheet">
                                <div class="monthSheetHead">
                                    <span class="monthSheetTitle" id="monthSheetTitle"></span>
                                    <span class="monthSheetHelp">
                                        <span class="qMark" aria-hidden="true">?</span>
                                        <span>한 줄 요약을 누르면 오른쪽에서 일기 원문을 볼 수 있어요. 지울 일기는 선택 칸에 체크하세요.</span>
                                    </span>
                                </div>

                                <div class="monthTableWrap">
                                    <table class="monthTable" aria-describedby="monthSheetTitle">
                                        <colgroup>
                                            <col class="colDay">
                                            <col class="colSummary">
                                            <col class="colRating">
                                            <col class="colSelect">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th scope="col">일</th>
                                                <th scope="col">일기 한 줄 요약</th>
                                                <th scope="col">내가 남겼던 별점</th>
                                                <th scope="col">선택</th>
                                            </tr>
                                        </thead>
                                        <tbody id="monthRows"></tbody>
                                    </table>
                                    <p class="monthEmpty muted" id="monthEmpty" hidden></p>
                                </div>

                                <div class="monthSheetFoot">
                                    <div class="deleteBubble" id="deleteBubble" role="alertdialog" aria-labelledby="deleteBubbleText" hidden>
                                        <p id="deleteBubbleText">정말로 삭제할 건가요?<br>삭제된 기록은 복구되지 않습니다.</p>
                                        <div class="deleteBubbleActions">
                                            <button type="button" class="deleteYes" id="deleteYes">예</button>
                                            <span aria-hidden="true">/</span>
                                            <button type="button" class="deleteNo" id="deleteNo">아니요</button>
                                        </div>
                                    </div>
                                    <button type="button" class="selectDeleteBtn" id="selectDeleteBtn" disabled>선택 삭제</button>
                                </div>
                            </div>

                            <!-- 왼쪽 아래 폴더: 누르면 폴더 목록으로 돌아감 -->
                            <button type="button" class="monthFolderIcon" id="monthBackBtn"
                                aria-label="폴더 목록으로 돌아가기" title="폴더 목록으로 돌아가기">
                                <span class="monthFolderTab" aria-hidden="true"></span>
                                <span class="monthFolderBody" aria-hidden="true">
                                    <span class="monthFolderNum" id="monthFolderNum">00</span>
                                </span>
                            </button>
                        </div>
                    </section>

                    <!-- 오른쪽: 일기 작성 -->
                    <section class="rightPage">
                        <button type="button" class="diaryHelpRow" id="diaryHelpRow" aria-expanded="false"
                            aria-controls="diaryHelpText">
                            <span class="qMark">?</span>
                            <span>기능이 궁금하신가요?</span>
                        </button>
                        <div class="diaryHelpText" id="diaryHelpText" hidden>
                            <p>· 날짜를 눌러 원하는 날의 일기를 쓰거나 불러올 수 있어요. 하루에 한 편이 저장돼요.</p>
                            <p>· 별점은 그날의 기분이에요. 왼쪽 기분 그래프에 월 평균으로 반영돼요.</p>
                            <p>· 자유형과 시간 기록형은 따로 저장돼서, 양식을 바꿔도 쓴 내용이 지워지지 않아요.</p>
                            <p>· 비공개로 저장하면 매우 친한 친구에게도 보이지 않아요.</p>
                        </div>

                        <div class="diaryHeaderRow">
                            <div class="diaryAvatar"></div>
                            <div class="diaryHeaderText">
                                <span class="diaryHeadline" id="diaryHeadline">일기 바로 작성</span>

                                <div class="starRating" id="starRating" data-value="0" role="radiogroup"
                                    aria-label="오늘의 기분 별점">
                                    <span class="star" data-value="1" role="radio" tabindex="0" aria-label="1점">★</span>
                                    <span class="star" data-value="2" role="radio" tabindex="-1" aria-label="2점">★</span>
                                    <span class="star" data-value="3" role="radio" tabindex="-1" aria-label="3점">★</span>
                                    <span class="star" data-value="4" role="radio" tabindex="-1" aria-label="4점">★</span>
                                    <span class="star" data-value="5" role="radio" tabindex="-1" aria-label="5점">★</span>
                                </div>
                                <input type="hidden" id="diaryRatingValue" name="rating" value="0">
                            </div>

                            <button type="button" class="diaryDateHint" id="diaryDateHint">클릭하여 날짜 입력 ex) 00.00.00</button>
                            <input type="date" class="diaryDateInput" id="diaryDateInput" aria-label="일기 날짜"
                                tabindex="-1">
                        </div>

                        <div class="formTabRow">
                            <button type="button" class="formTabBtn" id="freeformTabBtn">자유형 일기 양식</button>
                            <button type="button" class="formTabBtn active" id="timetableTabBtn">시간 기록형 일기
                                양식</button>
                        </div>

                        <!-- 자유형 양식: 배경 없이 노트 위에 바로 쓰기 -->
                        <div class="freeformArea plainNote" id="freeformArea">
                            <textarea id="freeformText" class="plainNoteText" maxlength="10000"
                                aria-label="자유형 일기" placeholder="일기를 자유롭게 작성해주세요."></textarea>
                        </div>

                        <!-- 시간 기록형 양식 -->
                        <div class="timetableArea show" id="timetableArea">
                            <div class="timetableGrid" id="timetableGrid">
                                <div class="timetableCol" id="timetableColLeft"></div>
                                <div class="timetableCol" id="timetableColRight"></div>
                            </div>
                        </div>

                        <p class="diaryStatus" id="diaryStatus" role="status" aria-live="polite"></p>

                        <div class="diarySaveRow">
                            <label class="privateToggle">
                                <input type="checkbox" id="diaryPrivate">
                                <span>비공개 🔒</span>
                            </label>
                            <button type="button" class="diaryDeleteBtn" id="diaryDeleteBtn" hidden>삭제</button>
                            <button type="button" class="diarySaveBtn" id="diarySaveBtn">저장</button>
                        </div>
                    </section>
                </section>
            </main>
        </div>

        <script src="/js/dairy.js?v=4"></script>
    </body>
</html>
