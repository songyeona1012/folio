<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>폴리오 - 로그인</title>

    <!-- 표지 글씨체: Folio(Cormorant Garamond) / 한글(Noto Serif KR) / 하단 문구(IBM Plex Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500&family=IBM+Plex+Mono:ital,wght@1,400&family=Noto+Serif+KR:wght@400;500&display=swap" rel="stylesheet">

    <!-- main과 동일한 공통 레이아웃 -->
    <link rel="stylesheet" href="/css/manage.css">
    <link rel="stylesheet" href="/css/calendar.css">
    <link rel="stylesheet" href="/css/sidebar.css">

    <!-- 로그인 전용 -->
    <link rel="stylesheet" href="/css/login.css">

    <!-- 반응형은 항상 맨 마지막에 (responsive.css 안내대로). 앞에 두면 login.css가 모바일 규칙을 덮어써서 책이 화면 밖으로 나간다. -->
    <link rel="stylesheet" href="/css/responsive.css?v=1">
</head>

<body>

<div class="appShell">

    <!-- 로그인 전 사이드바: 아직 이름이 없는 '무명'. 나머지 틀은 다른 페이지의 사이드바와 같다. -->
    <aside class="sideBar loginSide">

        <div class="userProfile">
            <div class="profileImage guestImage">
                <svg viewBox="0 0 62 66" aria-hidden="true">
                    <g fill="none" stroke="#f26a21" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round">
                        <!-- 깃펜 -->
                        <path d="M18.5 52.5 C15 46 14.2 40 14.5 33 C15 27 19 22 24 18.5 C29 15 34 12.8 37 12.2 C39.5 11.8 41.2 12 41.6 12.6 C41.4 16 38 19.5 36 21.5 C34.5 22.8 33 23.5 32 23.6 L37.4 23.8 C37 26 35 28.3 30 30.5"/>
                        <path d="M27.5 34 C25 37 21.5 39.5 20 41.5"/>
                        <path d="M16.5 43.5 C17.5 44.5 19 45.5 20.2 47 C21 49.5 20.8 51.5 19.5 52.8 C18.5 52.2 17 50.5 16.5 48.5 C16.2 46.5 16.2 45 16.5 43.5Z"/>
                        <path d="M18.5 33.5 C19.5 34.5 20.5 35 21.5 34.2 M21.5 32.6 C22 32.2 22.5 32.2 23 32.8"/>
                        <!-- 쓰다 남은 선 -->
                        <path d="M20 53.5 H28.5"/>
                        <ellipse cx="33" cy="49.6" rx="3.8" ry="2.2" transform="rotate(-18 33 49.6)"/>
                    </g>
                    <path d="M34 52.6 C38 51.4 42.5 50.4 47 49.4" fill="none" stroke="#cfcbc7" stroke-width="0.8" stroke-linecap="round" stroke-dasharray="3 1.6"/>
                </svg>
            </div>
            <div class="userInfo">
                <strong>무 명</strong>
                <span>작성되지 않음</span>
                <span>마지막 수정 : XXXX.XX.XX</span>
            </div>
        </div>

        <div class="sideLine"></div>

        <nav class="sideMenu">
            <a href="/main">달력</a>
            <a href="/dairy">일기</a>
            <a href="/index">관리</a>
            <a href="/goal">목표</a>
            <a href="/setting">설정</a>
        </nav>

        <p class="teamName">@ CREATED BY TEAM HIKING CLUB</p>

    </aside>

    <main class="mainArea loginMain">
        <!-- main과 동일한 상단 영역 -->
        <div class="topBar"></div>

        <section class="loginScene" id="loginScene">

            <!-- ====================================
                 로그인하면 보여 줄 펼쳐진 책
            ===================================== -->
            <div class="openBook">
                <img src="/img/notebook.png" alt="펼쳐진 Folio">
            </div>

            <!-- ====================================
                 닫힌 책 (가죽 표지). 로그인하면 표지가 왼쪽으로 넘어간다.
            ===================================== -->
            <div class="closedBook">
                <div class="closedBookPage">

                    <div class="bookBlock">

                        <!-- 종이 클립: 책 윗면 뒤에 꽂혀 있다 -->
                        <svg class="paperclip" viewBox="0 0 40 70" aria-hidden="true">
                            <defs>
                                <linearGradient id="clipMetal" x1="0" y1="0" x2="1" y2="0">
                                    <stop offset="0" stop-color="#9fa4ad"/>
                                    <stop offset="0.5" stop-color="#e4e6ea"/>
                                    <stop offset="1" stop-color="#9fa4ad"/>
                                </linearGradient>
                            </defs>
                            <path d="M9 70 V19 C9 5 31 5 31 19 V56 C31 63 22 63 22 56 V28" fill="none" stroke="url(#clipMetal)" stroke-width="1.7" stroke-linecap="round"/>
                            <path d="M15 70 V30 C15 24 19 24 19 30 V46" fill="none" stroke="url(#clipMetal)" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>

                        <div class="bookShadow">
                            <div class="book">

                                <div class="edgeTop"></div>
                                <div class="edgeRight"></div>

                                <!-- 가죽 표지 -->
                                <div class="cover">

                                    <h1 class="coverTitle">Folio</h1>

                                    <form class="loginForm" id="loginForm" novalidate>

                                        <!-- 저자명 / 암호 라벨 -->
                                        <div class="labelCard">
                                            <label class="labelRow" for="username">
                                                <span class="labelText">저자명 :</span>
                                                <input type="text" id="username" class="labelInput" name="username"
                                                       autocomplete="username" spellcheck="false" maxlength="30">
                                            </label>
                                            <label class="labelRow" for="password">
                                                <span class="labelText labelSpread">암 호 :</span>
                                                <input type="password" id="password" class="labelInput" name="password"
                                                       autocomplete="current-password" maxlength="50">
                                            </label>
                                            <button type="submit" class="enterButton" id="loginButton" aria-label="로그인하고 책 펼치기">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                        </div>

                                        <button type="button" class="signupLink" id="signupLink">폴리오의 저자가 되기</button>

                                        <p class="loginNote" id="loginNote" role="status" aria-live="polite"></p>

                                    </form>

                                    <p class="coverFoot">@ CREATED BY TEAM HIKING CLUB</p>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- 표지 안쪽 면: 표지가 넘어가면 보인다 -->
                    <div class="coverBack" aria-hidden="true"></div>

                </div>
            </div>
        </section>
    </main>
</div>

<script src="/js/login.js"></script>

</body>
</html>
