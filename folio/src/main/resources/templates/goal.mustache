<!DOCTYPE html>
{{! 목표 화면: 왼쪽 목표 목록과 오른쪽 작성 양식 및 관련 창을 배치합니다. }}
<html lang="ko">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>폴리오 - 목표</title>

        <link rel="stylesheet" href="/css/manage.css">
        <link rel="stylesheet" href="/css/calendar.css">
        <link rel="stylesheet" href="/css/sidebar.css">
        <link rel="stylesheet" href="/css/goal.css">
        <link rel="stylesheet" href="/css/responsive.css?v=1">

        <script src="/js/goal.js" defer></script>
        <link rel="stylesheet" href="/css/page-intro.css?v=1">
    </head>

    <body>
        <!-- 공용 아이콘: 웃는 얼굴 (목록 카드, 채팅 말풍선에서 사용) -->
        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
            <symbol id="icon-face" viewBox="0 0 40 40">
                <circle cx="13.5" cy="16" r="1.9" />
                <circle cx="26.5" cy="16" r="1.9" />
                <path d="M11.5 23.5c2 4.2 5.2 6 8.5 6s6.5-1.8 8.5-6" fill="none" stroke="currentColor"
                    stroke-width="2.4" stroke-linecap="round" />
            </symbol>
        </svg>

        <div class="appShell">

            {{> layout/sidebar}}

            <main class="mainArea">
                <div class="topBar"></div>

                <section class="notebook">

                    {{> layout/bookLayout}}

                    <!-- ========== 왼쪽 페이지: 목표 목록 ========== -->
                    <section class="leftPage">
                        <div class="goal-page">

                            <header class="goal-heading">
                                <h1>목표 :</h1>
                                <p>달성하고 싶은 목표가 있나요? 목표를 설정하고 도달까지의 과정을 확인하며 기록해 보세요.</p>
                            </header>

                            <div class="goal-toolbar">
                                <div class="goal-mode-bar" role="radiogroup" aria-label="작성 방식 선택">
                                    <label class="mode-option">
                                        <span>공부</span>
                                        <input type="radio" name="goalMode" value="form" checked>
                                        <i class="mode-radio" aria-hidden="true"></i>
                                    </label>
                                    <label class="mode-option">
                                        <span>금전</span>
                                        <input type="radio" name="goalMode" value="money">
                                        <i class="mode-radio" aria-hidden="true"></i>
                                    </label>
                                    <label class="mode-option">
                                        <span>AI 자율 작성</span>
                                        <input type="radio" name="goalMode" value="ai">
                                        <i class="mode-radio" aria-hidden="true"></i>
                                    </label>
                                    <button type="button" class="mode-new-goal" id="newGoalBtn">새 목표
                                        생성</button>
                                </div>
                                <span class="goal-list-label">선택</span>
                            </div>

                            <div class="goal-list-scroll">
                                <div class="goal-list" id="goalList" aria-live="polite"></div>
                            </div>

                            <div class="goal-list-footer">
                                <button type="button" id="deleteSelectedGoalsBtn" disabled>선택 삭제</button>
                            </div>

                        </div>
                    </section>

                    <!-- ========== 오른쪽 페이지: 에디터 ========== -->
                    <section class="rightPage">
                        <form id="goalForm" class="goal-paper is-entering" novalidate>

                            <!-- 저장 버튼은 없고, 수정하면 자동으로 저장된다 -->
                            <span class="save-status" id="saveStatus" role="status" aria-live="polite"></span>

                            <!-- 제목은 두 작성 방식이 함께 쓴다 -->
                            <input type="text" name="title" class="goal-title-input" placeholder="클릭하여 목표명 작성"
                                aria-label="목표명" maxlength="60" autocomplete="off">

                            <!-- ───── 공부 ───── -->
                            <div class="goal-panel" data-mode-panel="form">

                                <div class="form-top">
                                    <div class="goal-table">
                                        <label class="goal-table-label" for="startDate">기간</label>
                                        <div class="goal-table-cell goal-date-cell">
                                            <input type="text" id="startDate" name="startDate"
                                                class="date-mask" inputmode="numeric" placeholder="00.00.00"
                                                maxlength="8" autocomplete="off"
                                                aria-label="시작일 (연.월.일 숫자 6자리)">
                                            <span aria-hidden="true">~</span>
                                            <input type="text" id="endDate" name="endDate" class="date-mask"
                                                inputmode="numeric" placeholder="00.00.00" maxlength="8"
                                                autocomplete="off" aria-label="종료일 (연.월.일 숫자 6자리)">
                                        </div>

                                        <label class="goal-table-label" for="goalUnit">진행 단위</label>
                                        <div class="goal-table-cell">
                                            <input type="text" id="goalUnit" name="goalUnit" maxlength="50"
                                                autocomplete="off">
                                        </div>

                                        <label class="goal-table-label" for="goalFrequency">학습 빈도</label>
                                        <div class="goal-table-cell">
                                            <input type="text" id="goalFrequency" name="goalFrequency"
                                                maxlength="255" autocomplete="off">
                                        </div>

                                        <label class="goal-table-label" for="specialNotes">특이 사항</label>
                                        <div class="goal-table-cell">
                                            <input type="text" id="specialNotes" name="specialNotes"
                                                maxlength="255" autocomplete="off">
                                        </div>

                                        <label class="goal-table-label" for="goalPromise">다짐</label>
                                        <div class="goal-table-cell">
                                            <input type="text" id="goalPromise" name="goalPromise"
                                                maxlength="255" autocomplete="off">
                                        </div>
                                    </div>

                                    <aside class="dday-box" aria-live="polite">
                                        <strong class="dday-count" id="ddayCount">D - 00</strong>
                                        <p class="dday-hint" id="ddayHint"></p>
                                    </aside>
                                </div>

                                <!-- 제목 줄: 스크롤해도 고정 -->
                                <div class="item-heads">
                                    <div class="item-section-head">
                                        <button type="button" class="progress-add-btn" id="progressAddBtn"
                                            aria-haspopup="true" aria-expanded="false"
                                            aria-controls="progressMenu">진도표 추가</button>
                                    </div>
                                    <header class="item-section-head">
                                        <h2 id="reviewTitle">오늘의 공부 한 줄 리뷰</h2>
                                        <button type="button" class="clear-selected" id="clearNotesBtn"
                                            disabled>선택 삭제</button>
                                    </header>
                                </div>

                                <!-- 제목 줄 바로 아래부터 스크롤 -->
                                <div class="item-scroll">
                                    <div class="item-cols">
                                        <div class="item-col" role="group" aria-label="진도표">
                                            <div class="progress-list" id="progressList"></div>
                                        </div>
                                        <div class="item-col" role="group" aria-labelledby="reviewTitle">
                                            <div class="item-list" id="noteItems"></div>
                                            <button type="button" class="add-item-btn" id="addNoteBtn"
                                                aria-label="한 줄 리뷰 추가">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ───── 금전 ─────
                         위쪽(남은 금액·표·사진)은 고정, 달성 현황과 입출금 내역은 제목 줄 아래부터 스크롤 -->
                            <div class="goal-panel" data-mode-panel="money" hidden>

                                <div class="money-top">
                                    <div class="money-main">
                                        <p class="money-remain">앞으로 남은 금액 :
                                            <b id="moneyRemain" class="is-empty">–</b>
                                        </p>
                                        <p class="money-sum" aria-live="polite">
                                            <span id="moneyCurrent" class="is-empty">–</span><i
                                                aria-hidden="true">/</i><span id="moneyGoalView"
                                                class="is-empty">–</span>
                                        </p>

                                        <div class="goal-table money-table">
                                            <label class="goal-table-label" for="moneyStartDate">기간</label>
                                            <div class="goal-table-cell goal-date-cell">
                                                <input type="text" id="moneyStartDate" name="moneyStartDate"
                                                    class="date-mask" inputmode="numeric"
                                                    placeholder="00.00.00" maxlength="8" autocomplete="off"
                                                    aria-label="시작일 (연.월.일 숫자 6자리)">
                                                <span aria-hidden="true">~</span>
                                                <input type="text" id="moneyEndDate" name="moneyEndDate"
                                                    class="date-mask" inputmode="numeric"
                                                    placeholder="00.00.00" maxlength="8" autocomplete="off"
                                                    aria-label="종료일 (연.월.일 숫자 6자리)">
                                            </div>

                                            <label class="goal-table-label" for="moneyTarget">목표 금액</label>
                                            <div class="goal-table-cell money-amount-cell">
                                                <input type="text" id="moneyTarget" name="moneyTarget"
                                                    class="money-input" inputmode="numeric"
                                                    placeholder="00,000,000,000" maxlength="16"
                                                    autocomplete="off" aria-label="목표 금액 (1만원 이상 100억원 미만)">
                                                <span class="money-won" aria-hidden="true">₩</span>
                                            </div>

                                            <label class="goal-table-label" for="moneyInitial">시작 금액</label>
                                            <div class="goal-table-cell money-amount-cell">
                                                <input type="text" id="moneyInitial" name="moneyInitial"
                                                    class="money-input" inputmode="numeric"
                                                    placeholder="00,000,000,000" maxlength="16"
                                                    autocomplete="off" aria-label="시작 금액">
                                                <span class="money-won" aria-hidden="true">₩</span>
                                            </div>

                                            <label class="goal-table-label" for="moneyDeposit">입금 금액과
                                                주기</label>
                                            <div class="goal-table-cell money-cycle-cell">
                                                <input type="text" id="moneyDeposit" name="moneyDeposit"
                                                    class="money-input money-deposit" inputmode="numeric"
                                                    placeholder="00,000,000,000" maxlength="16"
                                                    autocomplete="off" aria-label="한 번에 입금할 금액">
                                                <span class="money-unit">₩ 씩</span>
                                                <i class="money-slash" aria-hidden="true">/</i>
                                                <input type="text" id="moneyCycle" name="moneyCycle"
                                                    class="money-cycle" maxlength="30" autocomplete="off"
                                                    aria-label="입금 주기 (예: 매 달 4일, 매 주 월요일, 3일)">
                                                <span class="money-unit">마다</span>
                                            </div>
                                        </div>

                                        <p class="money-hint" id="moneyHint" role="status" hidden></p>
                                    </div>

                                    <!-- 사진: 내 컴퓨터에서 올리기 / 외부 검색(새 탭에서 검색 후 복사·붙여넣기 또는 끌어다 놓기) -->
                                    <div class="money-photo" id="moneyPhoto">
                                        <img class="photo-img" id="moneyPhotoImg" alt="목표 사진" hidden
                                            referrerpolicy="no-referrer" draggable="false">
                                        <div class="photo-empty" id="moneyPhotoEmpty">
                                            <button type="button" class="photo-pick" id="photoUploadBtn">내
                                                컴퓨터에서 업로드</button>
                                            <button type="button" class="photo-pick" id="photoSearchBtn">외부
                                                검색</button>
                                        </div>
                                        <div class="photo-tools" id="photoTools" hidden>
                                            <button type="button" class="photo-tool" id="photoChangeBtn">업로드
                                            </button>
                                            <button type="button" class="photo-tool" id="photoSearchBtn2">외부
                                                검색</button>
                                            <button type="button" class="photo-tool" id="photoRemoveBtn">삭제
                                            </button>
                                        </div>
                                        <input type="file" id="photoFile" accept="image/*" hidden>
                                    </div>
                                </div>

                                <!-- 제목 줄: 스크롤해도 고정 -->
                                <div class="money-heads">
                                    <h2>달성 현황</h2>
                                    <div class="money-heads-right">
                                        <h2>입출금 내역</h2>
                                        <button type="button" class="clear-selected" id="clearTxBtn" disabled>
                                            선택 삭제</button>
                                    </div>
                                </div>

                                <div class="money-scroll">
                                    <div class="money-cols">
                                        <!-- 달성 현황: 계산한 글이 자동으로 쓰이고, 고쳐 쓰면 그 내용대로 입력값이 바뀐다 -->
                                        <div class="money-status-box">
                                            <div class="money-status" id="moneyStatus" role="textbox"
                                                aria-multiline="true" data-placeholder="목표를 설정해 주세요."
                                                aria-label="달성 현황. 날짜나 금액을 고쳐 쓰면 입력값에 반영돼요."
                                                spellcheck="false"></div>
                                            <div class="money-apply" id="moneyApply" hidden>
                                                <button type="button" class="money-apply-btn"
                                                    id="moneyApplyBtn">적용하기</button>
                                            </div>
                                        </div>

                                        <div class="tx-wrap">
                                            <div class="tx-head" aria-hidden="true">
                                                <span>일자</span><span>시간</span><span>입출금
                                                    유형</span><span>금액</span><span>총 액</span>
                                            </div>
                                            <div class="tx-list" id="txList"></div>
                                            <button type="button" class="add-item-btn" id="addTxBtn"
                                                aria-label="입출금 내역 추가">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ───── AI 자율 작성 ─────
                         깃펜을 누르면 도우미 말풍선과 입력칸이 나타난다. 그 전에는 깃펜과 줄만 보인다. -->
                            <div class="goal-panel ai-scroll" data-mode-panel="ai" hidden>
                                <div class="ai-top">
                                    <button type="button" class="ai-quill" id="aiQuill" aria-expanded="false"
                                        aria-controls="aiChat" aria-label="깃펜 — 눌러서 양식 도우미 열기">
                                        <svg class="quill" viewBox="0 0 96 70" aria-hidden="true">
                                            <defs>
                                                <radialGradient id="quillGlow" cx="50%" cy="50%" r="50%">
                                                    <stop offset="0" stop-color="#ffcf4d"
                                                        stop-opacity="0.72" />
                                                    <stop offset="0.55" stop-color="#ffd978"
                                                        stop-opacity="0.34" />
                                                    <stop offset="1" stop-color="#ffe9a8" stop-opacity="0" />
                                                </radialGradient>
                                            </defs>
                                            <circle class="quill-glow" cx="56" cy="30" r="28"
                                                fill="url(#quillGlow)" />
                                            <path class="quill-trail"
                                                d="M3 60 C16 56 24 51 33 52 C42 53 37 59 48 55 C53 53 55 52 58 51"
                                                fill="none" />
                                            <path class="quill-body"
                                                d="M52 46 C43 41 40 29 46 17 C48 12 54 9 58 6 C57 10 59 12 63 12 C66 12 68 10 69 8 C71 17 68 28 61 37 C59 41 56 44 52 46 Z" />
                                            <path class="quill-vein" d="M52 45 C53 36 56 25 63 14"
                                                fill="none" />
                                            <circle class="quill-eye" cx="52" cy="27" r="1.2" />
                                            <circle class="quill-eye" cx="57" cy="28" r="1.2" />
                                            <path class="quill-nib" d="M48 44 L54 42 L56 48 L50 54 Z" />
                                        </svg>
                                    </button>

                                    <div class="ai-chat" id="aiChat" hidden>
                                        <div class="ai-pill ai-pill-bot" id="aiGreeting">작성하기 어렵다면 양식을 만들어
                                            드릴게요! 어떤 목표를 가지고 계신가요?</div>
                                    </div>
                                </div>

                                <div class="ai-thread" id="chatMessages" aria-live="polite"></div>

                                <div class="ai-compose" id="aiCompose" hidden>
                                    <textarea id="aiPrompt" class="ai-input" rows="1"
                                        placeholder="클릭하여 작성  (예: 3개월 안에 토익 900점 받고 싶어요)"
                                        aria-label="도우미에게 보낼 말 (Enter로 보내기, Shift+Enter로 줄바꿈)"></textarea>
                                    <button type="button" class="ai-send" id="aiSendBtn" aria-label="보내기"
                                        disabled>
                                        <svg viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M2 8h11M8.5 3.5L13 8l-4.5 4.5" fill="none"
                                                stroke="currentColor" stroke-width="1.7"
                                                stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </button>
                                </div>

                                <!-- 지운 것을 되돌리는 줄 (블록 삭제, 양식 모두 지우기, 양식이 바뀌었을 때) -->
                                <div class="ai-undo" id="aiUndo" role="status" aria-live="polite" hidden>
                                    <span class="ai-undo-text"></span>
                                    <button type="button" class="ai-undo-btn">되돌리기</button>
                                </div>

                                <!-- 도우미가 만들어 준 양식: 기간 + 블록들. 어떤 블록을 쓸지는 AI가 목표에 맞게 고른다. 모든 칸은 클릭해서 바로 고친다 -->
                                <section class="ai-form" id="aiForm" aria-label="도우미가 만든 양식" hidden>
                                    <div class="goal-table ai-table ai-period">
                                        <label class="goal-table-label" for="aiStartDate">기간</label>
                                        <div class="goal-table-cell goal-date-cell">
                                            <input type="text" id="aiStartDate" name="aiStartDate"
                                                class="date-mask" inputmode="numeric" placeholder="00.00.00"
                                                maxlength="8" autocomplete="off"
                                                aria-label="시작일 (연.월.일 숫자 6자리)">
                                            <span aria-hidden="true">~</span>
                                            <input type="text" id="aiEndDate" name="aiEndDate"
                                                class="date-mask" inputmode="numeric" placeholder="00.00.00"
                                                maxlength="8" autocomplete="off"
                                                aria-label="종료일 (연.월.일 숫자 6자리)">
                                        </div>
                                    </div>
                                    <div class="ai-blocks" id="aiBlocks"></div>
                                    <div class="ai-form-foot" role="group" aria-label="블록 추가">
                                        <button type="button" class="ai-add" data-add="table">+ 항목 표</button>
                                        <button type="button" class="ai-add" data-add="checklist">+
                                            체크리스트</button>
                                        <button type="button" class="ai-add" data-add="tracker">+ 습관표</button>
                                        <button type="button" class="ai-add" data-add="progress">+
                                            진행도</button>
                                        <button type="button" class="ai-add" data-add="log">+ 기록표</button>
                                        <button type="button" class="ai-add" data-add="note">+ 메모</button>
                                    </div>
                                    <div class="ai-form-reset">
                                        <button type="button" class="ai-reset" id="aiResetBtn">만든 양식 모두
                                            지우기</button>
                                    </div>
                                </section>

                                <!-- 시안의 줄 노트: 도움 없이 이곳을 클릭하면 바로 자유롭게 쓸 수 있다 -->
                                <textarea id="freeMemo" name="freeMemo" class="free-memo"
                                    aria-label="자유 메모 (줄 노트)"></textarea>
                            </div>
                        </form>
                    </section>
                </section>
            </main>
        </div>

        <!-- ===== 진도표 추가 메뉴 =====
     종이(스크롤/둥근 모서리 영역) 밖에 두어서 가장자리에 잘리지 않는다. 위치는 goal.js가 버튼/표 옆으로 맞춘다. -->
        <div class="pm" id="progressMenu" hidden>
            <div class="pm-panel" role="menu" aria-label="진도표 종류">
                <button type="button" class="pm-item" role="menuitem" data-kind="NUMBER" aria-haspopup="true">
                    <strong>숫자형</strong>
                    <span class="pm-desc">날짜 또는 인터넷 강의 등에서 적합한 숫자를 지워나가는 형태</span>
                    <svg class="pm-arrow" viewBox="0 0 10 12" aria-hidden="true">
                        <path d="M1.5 1.5v9l7-4.5z" />
                    </svg>
                </button>
                <button type="button" class="pm-item" role="menuitem" data-kind="TEXT" aria-haspopup="true">
                    <strong>글자형</strong>
                    <span class="pm-desc">단원 또는 특정 수행 과정 등을 직접 작성하여 지워나가는 형태</span>
                    <svg class="pm-arrow" viewBox="0 0 10 12" aria-hidden="true">
                        <path d="M1.5 1.5v9l7-4.5z" />
                    </svg>
                </button>
            </div>

            <!-- 항목에 마우스를 올리면 옆에 팝업이 나타난다. 값이 입력되면 닫기 버튼이 생기고 그 버튼으로만 닫힌다. -->
            <div class="pm-sub" data-for="NUMBER" role="group" aria-label="숫자형 진도표 만들기">
                <button type="button" class="pm-close" aria-label="닫기">&#10005;</button>
                <div class="pf-mount" data-mount="create"></div>
            </div>
            <div class="pm-sub" data-for="TEXT" role="group" aria-label="글자형 진도표 만들기">
                <button type="button" class="pm-close" aria-label="닫기">&#10005;</button>
                <div class="pf-mount" data-mount="create-text"></div>
            </div>
        </div>

        <!-- ===== 글자형 진도표: 줄을 클릭하면 그 줄 왼쪽에 뜨는 삭제 메뉴. 다른 곳을 클릭하면 사라진다 ===== -->
        <div class="rm" id="rowMenu" hidden>
            <button type="button" class="rm-delete">삭제하기</button>
        </div>

        <!-- ===== 진도표 수정 패널: 표를 클릭하면 표 왼쪽에 나타난다 ===== -->
        <div class="pe" id="progressEdit" role="group" aria-label="진도표 수정" hidden>
            <button type="button" class="pe-close" aria-label="닫기">&#10005;</button>
            <div class="pf-mount" data-mount="edit"></div>
        </div>

        <!-- 만들기/수정 패널이 같이 쓰는 입력 양식 (수의 개수, 행, 열, 미리보기) -->
        <template id="progressFormTemplate">
            <div class="pf">
                <p class="pf-name" hidden><span>표 이름 :</span> <strong class="pf-name-text"></strong></p>
                <label class="pf-row"><span>수의 개수</span>
                    <input type="text" class="pf-field" data-field="count" inputmode="numeric" maxlength="3"
                        placeholder="000" autocomplete="off">
                </label>
                <label class="pf-row"><span>행</span>
                    <input type="text" class="pf-field" data-field="rows" inputmode="numeric" maxlength="3"
                        placeholder="000" autocomplete="off">
                </label>
                <label class="pf-row"><span>열</span>
                    <input type="text" class="pf-field" data-field="cols" inputmode="numeric" maxlength="3"
                        placeholder="000" autocomplete="off">
                </label>
                <div class="pf-actions">
                    <button type="button" class="pf-submit" disabled>생성하기</button>
                    <button type="button" class="pf-delete" hidden>표 삭제하기</button>
                </div>
                <p class="pf-error" role="alert" hidden></p>
                <div class="pf-preview" hidden aria-hidden="true">
                    <div class="pf-preview-grid"></div>
                    <span class="pf-preview-label">미리보기</span>
                </div>
            </div>
        </template>

        <!-- 글자형 만들기 팝업: 표 이름을 써야 '생성하기'가 활성화된다 -->
        <template id="textFormTemplate">
            <div class="pf pf-text">
                <label class="pf-name pf-name-edit">
                    <span>표 이름 :</span>
                    <input type="text" class="pf-name-input" maxlength="30" placeholder="터치하여 작성"
                        autocomplete="off" aria-label="표 이름">
                </label>
                <div class="pf-actions">
                    <button type="button" class="pf-submit" disabled>생성하기</button>
                </div>
            </div>
        </template>

        <!-- ===== 동적 항목 템플릿 (JS가 복제해서 사용) ===== -->

        <!-- 글자형 진도표의 한 줄: 회색 핸들(눌러서 순서 변경) + 한 줄 글(클릭하면 바로 수정) + 완료 체크 -->
        <template id="textRowTemplate">
            <div class="text-row">
                <button type="button" class="text-handle" aria-label="순서 바꾸기 (누른 채 위아래로 움직이세요)"></button>
                <input type="text" class="text-cell" maxlength="100" placeholder="클릭하여 작성" aria-label="진도표 항목"
                    autocomplete="off">
                <input type="checkbox" class="text-check" aria-label="완료">
            </div>
        </template>

        <!-- 왼쪽 목록의 목표 카드 -->
        <template id="goalCardTemplate">
            <div class="goal-card-row">
                <button type="button" class="goal-card" aria-pressed="false">
                    <span class="goal-card-side">
                        <span class="goal-card-avatar">
                            <svg class="face" aria-hidden="true">
                                <use href="#icon-face" />
                            </svg>
                        </span>
                    </span>
                    <span class="goal-card-copy">
                        <span class="goal-card-title"></span>
                        <span class="goal-card-dates">
                            <span class="goal-card-start"></span>
                            <span class="goal-card-end"></span>
                        </span>
                        <span class="goal-card-updated"></span>
                    </span>
                </button>
                <input type="checkbox" class="goal-select-checkbox">
            </div>
        </template>

        <!-- 금전: 입출금 내역 한 줄. 일자/시간/유형/금액은 클릭해서 바로 고치고, 총 액은 계산해서 채워진다.
     줄은 일자·시간 순서대로 자동으로 놓인다(따로 정렬 기능은 없다). -->
        <template id="txRowTemplate">
            <div class="tx-row">
                <div class="tx-box">
                    <input type="text" class="tx-date" inputmode="numeric" maxlength="8"
                        placeholder="00.00.00" aria-label="일자 (연.월.일 숫자 6자리)" autocomplete="off">
                    <input type="text" class="tx-time" inputmode="numeric" maxlength="5" placeholder="00:00"
                        aria-label="시간 (시:분)" autocomplete="off">
                    <span class="tx-type" role="group" aria-label="입출금 유형">
                        <button type="button" class="tx-type-btn" data-type="IN" aria-pressed="false">입금
                        </button>
                        <i aria-hidden="true">/</i>
                        <button type="button" class="tx-type-btn" data-type="OUT" aria-pressed="false">출금
                        </button>
                    </span>
                    <input type="text" class="tx-amount" inputmode="numeric" maxlength="16"
                        placeholder="00,000,000,000" aria-label="금액" autocomplete="off">
                    <div class="tx-total" aria-label="총 액"></div>
                </div>
                <input type="checkbox" class="tx-select" aria-label="삭제할 내역으로 선택">
            </div>
        </template>

        <!-- 오늘의 공부 한 줄 리뷰 한 칸: 날짜(숫자 입력) + 한 줄 + 선택 체크박스. 모두 클릭해서 바로 수정하는 인라인 입력 -->
        <template id="noteTemplate">
            <div class="note-row">
                <div class="note-box">
                    <div class="review-date" role="group" aria-label="작성일">
                        <input type="text" class="rd-part" inputmode="numeric" maxlength="2" placeholder="00"
                            aria-label="년 (두 자리)"><span>년</span>
                        <input type="text" class="rd-part" inputmode="numeric" maxlength="2" placeholder="00"
                            aria-label="월"><span>월</span>
                        <input type="text" class="rd-part" inputmode="numeric" maxlength="2" placeholder="00"
                            aria-label="일"><span>일</span>
                    </div>
                    <input type="text" class="review-text" maxlength="100" placeholder="클릭하여 한 줄 작성"
                        aria-label="오늘의 공부 한 줄 리뷰" autocomplete="off">
                </div>
                <input type="checkbox" class="item-select" aria-label="삭제할 리뷰로 선택">
            </div>
        </template>

    </body>

</html>
